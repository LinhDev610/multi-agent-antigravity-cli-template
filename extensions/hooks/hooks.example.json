{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File ./scripts/safety-check.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "post-edit-linter": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "file_change",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint:quick",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
